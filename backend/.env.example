# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── JWT (OWASP-compliant) ────────────────────────────────────────────────────
# Access token: max 15 minutes
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=15m

# Refresh token: max 7 days
JWT_REFRESH_SECRET=change-this-to-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# ─── Super Admin ──────────────────────────────────────────────────────────────
SUPER_ADMIN_PASSWORD=change-this-strong-password

# ─── SMS — MSG91 ──────────────────────────────────────────────────────────────
MSG91_AUTH_KEY=your-msg91-auth-key

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
